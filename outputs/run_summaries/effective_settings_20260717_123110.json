{
  "schema_version": 1,
  "project_name": "nhs_rtt_msc_project",
  "random_seed": 42,
  "deterministic_torch": false,
  "data_start_month": "2015-10-01",
  "forecasting": {
    "target_column": "incomplete_total",
    "encoder_length": 24,
    "prediction_length": 12,
    "forecast_horizon": 12,
    "validation_months": 12,
    "test_months": 12,
    "rolling_origin_horizon": 12,
    "rolling_origin_step_months": 6,
    "rolling_origin_count": 3
  },
  "model": {
    "model_class": "TCNQuantileRegressor",
    "quantiles": [
      0.1,
      0.5,
      0.9
    ],
    "hidden_channels": 96,
    "tcn_levels": 5,
    "kernel_size": 3,
    "dropout": 0.15,
    "embedding_dim": 16,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "batch_size": 512,
    "max_epochs": 35,
    "early_stopping_patience": 7,
    "gradient_clip_norm": 1.0,
    "num_workers": 0
  },
  "optimisation": {
    "method": "mixed-integer linear programming",
    "default_available_sessions": 500,
    "capacity_budgets": [
      100,
      250,
      500,
      750,
      1000
    ],
    "default_max_sessions_per_trust_specialty_month": 12,
    "productivity_scenario": "central",
    "objective_weights": {
      "remaining_backlog": 1.0,
      "long_wait_backlog": 0.0,
      "weighted_backlog": 0.0,
      "trust_inequality": 0.0,
      "capacity_cost": 0.001
    },
    "scenario_parameter_note": "Capacity/productivity values are dissertation scenario assumptions, not observed NHS operating facts unless replaced with sourced local data."
  }
}